{
  "expo": {
    "name": "UnitNest",
    "slug": "UnitNest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app_images/app_logo.jpg",
    "scheme": "unitnest",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6366F1",
        "backgroundImage": "./assets/app_images/app_logo.jpg"
       
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.uninest.UnitNest"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/app_images/app_logo.jpg",
          "imageWidth": 76
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0f1badac-4016-4828-a086-73f6972a3853"
      }
    },
    "owner": "bilalbhatti"
  }
}
